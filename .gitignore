# Only reviewed source-tree content is allowed.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/Cargo.toml
!/Cargo.lock
!/play.ps1
!/core/
/core/*
!/core/Cargo.toml
!/core/src/
!/core/src/**
!/core/examples/
!/core/examples/**
!/core/fixtures/
/core/fixtures/*
!/core/fixtures/vehicle_20261007_gearbox.csv
!/core/fixtures/vehicle_20261007_rotation.csv
!/core/fixtures/vehicle_20261007_springs.csv
!/game/
/game/*
!/game/Cargo.toml
!/game/README.md
!/game/src/
!/game/src/**
!/docs/
/docs/*
!/docs/release-audit.md
!/scripts/
/scripts/*
!/scripts/audit-release.ps1
!/scripts/build-release.ps1
!/scripts/package-release.ps1
!/scripts/release_artifacts.py
!/scripts/Start-Bumblebee.ps1
!/scripts/Start-Bumblebee.cmd
!/docs/third-party-notices.md
!/docs/player-quickstart.md
!/docs/release-notes.md
!/LICENSE
!/rust-toolchain.toml
!/notes/
/notes/*
!/notes/status.md

# Never commit original/extracted media, binaries, symbols or logs.
*.str
*.apk
*.fsb
*.fev
*.gfx
*.lsa
*.dds
*.png
*.jpg
*.jpeg
*.bmp
*.tga
*.wav
*.mp3
*.ogg
*.mp4
*.avi
*.bik
*.exe
*.dll
*.pdb
*.zip
*.7z
*.log
